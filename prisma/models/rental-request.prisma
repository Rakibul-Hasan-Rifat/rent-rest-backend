model RentalRequest {
    id                String              @id @default(uuid())
    moveInDate        DateTime?
    leaseDuration     Decimal
    leaseDurationType LeaseDurationType   @default(MONTH)
    status            RentalRequestStatus @default(APPROVED)
    respondedAt       DateTime            @default(now())
    createdAt         DateTime            @default(now())
    updatedAt         DateTime            @updatedAt

    @@map("rental-requests")
}
