model Property {
    id            String              @id @default(uuid())
    title         String
    description   String?
    addressLine   String
    city          String
    district      String
    zipCode       Int?
    latitude      Float?
    longitude     Float?
    price         Decimal             @db.Decimal(10, 2)
    pricePeriod   PropertyPricePeriod @default(DAILY)
    bedrooms      String?
    bathrooms     String?
    areaSqft      String?
    status        PropertyStatus      @default(AVAILABLE)
    images        String[]
    createdAt     DateTime            @default(now())
    updatedAt     DateTime            @updatedAt
    
    landlordId    String
    landlord      User               @relation(fields: [landlordId], references: [id])
    categoryId    String?
    category      Category?           @relation(fields: [categoryId], references: [id])
    rentalRequest RentalRequest[]
    review        Review[]

    @@map("properties")
}
